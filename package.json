{
  "name": "sinnara",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "npm run validate:inventory && next build",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "serve": "node scripts/serve.mjs",
    "validate:inventory": "tsc --module commonjs --target es2022 --moduleResolution node --esModuleInterop --skipLibCheck --outDir .inventory-build scripts/validate-inventory.ts && node .inventory-build/scripts/validate-inventory.js"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "5.9.3",
    "@axe-core/playwright": "4.10.2"
  }
}
